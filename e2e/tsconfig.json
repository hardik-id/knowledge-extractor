{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../e2e-live/**/*.ts",
    "../e2e-live/**/*.mjs",
    "../playwright.config.ts",
    "../playwright.status.config.ts",
    "../e2e-status/**/*.ts"
  ]
}
