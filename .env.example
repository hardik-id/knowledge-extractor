# Copy to .env.local and adjust. Restart `npm run dev` after a change.

# mock: everything runs in the browser, no backend needed (default).
# http: the Django API and its WebSocket.
NEXT_PUBLIC_BACKEND_MODE=mock

# Needed in http mode. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional. Default: the API's host over ws:// or wss://.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Local development only, ignored in production builds: a JWT access token to
# send with every request. Used only when NEXT_PUBLIC_AUTH_MODE is none. It
# ends up in the browser bundle, so never put a production token here.
NEXT_PUBLIC_DEV_ACCESS_TOKEN=

# The apps the shell offers, comma-separated, in the order to offer them: studio,
# pipeline. `/` goes to the first. Left out: every app (pipeline first). One app
# means no app switcher, and the other app's routes answer "not found". An unknown
# id or an empty list fails the build. Fixed at build time.
# NEXT_PUBLIC_APPS=studio

# none: no sign-in (default).
# entra: sign in with Microsoft Entra ID; needs the two ids below.
# fake: a pretend account for local checks. Production builds refuse it.
# A production build against the real API (http mode) needs entra.
# With sign-in on, open the app at http://localhost:3000: Microsoft only
# accepts http for localhost, not for 127.0.0.1 or a machine name.
NEXT_PUBLIC_AUTH_MODE=none

# Needed when the auth mode is entra: the tenant id and the client id of the
# app registration. Neither is a secret.
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_CLIENT_ID=11111111-1111-1111-1111-111111111111

# Optional. The scope the access token is asked for.
# Default: api://<client id>/access_as_user
# NEXT_PUBLIC_ENTRA_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user

# ── Knowledge Studio with the local Django API ──────────────────────────────
# hardik-id/knowledge-extractor-api on http://localhost:8000. `make ui-env` in
# that repository prints these five lines with a fresh token (valid eight
# hours; a new one after its api container is recreated). They replace the
# backend mode, the URLs, the dev token and the apps above.
# NEXT_PUBLIC_BACKEND_MODE=http
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# NEXT_PUBLIC_APPS=studio
# NEXT_PUBLIC_DEV_ACCESS_TOKEN=<token from make token>
#
# `npm run test:api` walks the Studio flow against that API without a browser.
# It reads API_BASE_URL (default http://localhost:8000/api/v1) and
# DEV_ACCESS_TOKEN from the shell, not from this file:
#   DEV_ACCESS_TOKEN=<token> npm run test:api
