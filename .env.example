# Copy to .env.local and adjust. Restart `npm run dev` after a change.

# Which app this build is.
# pipeline: the full pipeline (default).
# studio: Knowledge Studio, which picks enriched documents from storage and goes
#         straight to extraction. `npm run dev:studio` runs it on port 3001.
NEXT_PUBLIC_APP_MODE=pipeline

# mock: everything runs in the browser, no backend needed (default).
# http: the Django API and its WebSocket.
NEXT_PUBLIC_BACKEND_MODE=mock

# Needed in http mode. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional. Default: the API's host over ws:// or wss://.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Local development only, ignored in production builds: a JWT access token to
# use until sign-in is connected. It ends up in the browser bundle, so never
# put a production token here.
NEXT_PUBLIC_DEV_ACCESS_TOKEN=
